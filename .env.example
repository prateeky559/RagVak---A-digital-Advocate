# Application Configuration
APP_ENV="development"
APP_NAME="Legal Document QA RAG"
APP_VERSION="1.0.0"
DEBUG="true"

# Database Configuration (PostgreSQL with pgvector for production, SQLite/Postgres hybrid support)
DATABASE_URL="postgresql://legal_user:legal_password@localhost:5432/legal_rag_db"

# Redis Cache and Rate Limiting
REDIS_URL="redis://localhost:6379/0"

# JWT Security & Session
JWT_SECRET_KEY="replace-this-with-a-secure-random-secret-key-in-production"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES="60"
JWT_REFRESH_TOKEN_EXPIRE_DAYS="7"

# LLM Provider Configuration (gemini, openai, or local)
LLM_PROVIDER="gemini"
GEMINI_API_KEY="your-gemini-api-key-here"
LLM_API_KEY="your-api-key-here"
LLM_MODEL="gemini-3.8-flash"

# Embedding Provider Configuration (gemini, openai, huggingface, or local)
EMBEDDING_PROVIDER="gemini"
EMBEDDING_API_KEY="your-api-key-here"
EMBEDDING_MODEL="gemini-embedding-2-preview"

# Vector Store Engine (pgvector, qdrant, or file-persistent)
VECTOR_STORE_TYPE="pgvector"

# CORS & Network
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Rate Limiting & Upload Policies
RATE_LIMIT_PER_MINUTE="60"
LOG_LEVEL="INFO"
MAX_UPLOAD_SIZE_MB="25"
ADMIN_EMAIL="admin@legalrag.internal"

# Cloud Run / AI Studio App URL
APP_URL="http://localhost:3000"
